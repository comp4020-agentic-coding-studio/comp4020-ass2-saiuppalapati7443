---
// Claim tickets sized by weight: the four assessments as one strip, wide in
// proportion to what they are worth, with a closing ticket reading the total.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

const assessments = (await getPublishedCollection("assessments")).sort(
  (a, b) => a.data.week - b.data.week,
);
const total = assessments.reduce((sum, a) => sum + a.data.weight, 0);
---

<ul class="assessment-strip" aria-label="Assessment weights, as a proportion of the total">
  {
    assessments.map((assessment) => (
      <li class="ticket assessment-ticket" style={`flex-grow: ${assessment.data.weight}`}>
        <a href={withBase(`/assessments/${assessment.id}/`)}>
          <span class="assessment-ticket-weight">{assessment.data.weight}%</span>
          <span class="assessment-ticket-title">{assessment.data.title}</span>
        </a>
      </li>
    ))
  }
  <li class="ticket assessment-ticket assessment-ticket-total">
    <span class="assessment-ticket-weight">{total}%</span>
    <span class="assessment-ticket-title">Total</span>
  </li>
</ul>

<style>
  .assessment-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--at-spacing-sm);
    margin-block: var(--at-spacing-xl);
    padding: 0;
    list-style: none;
  }

  .assessment-ticket {
    flex: 1 1 8rem;
    align-items: stretch;
  }

  .assessment-ticket a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
  }

  .assessment-ticket a:hover .assessment-ticket-title {
    text-decoration: underline;
  }

  .assessment-ticket-weight {
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-lg);
    font-weight: 600;
  }

  .assessment-ticket-title {
    font-size: var(--at-font-size-sm);
    color: var(--at-text-secondary);
    white-space: normal;
  }

  .assessment-ticket-total {
    border-style: solid;
    border-color: var(--at-accent);
    background: var(--at-bg-alt);
    font-weight: 600;
  }
</style>
