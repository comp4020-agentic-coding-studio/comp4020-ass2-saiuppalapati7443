---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import { getCollection } from "astro:content";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
import { weeks } from "../data/weeks";
import "../styles/office.css";

// STARTER_CONTENT: replace the hero artwork and its alt text below, then
// remove this comment.

const publishedLectures = await getCollection(
  "lectures",
  (entry) => entry.data.published !== false,
);
const lectureSlugs = new Set(publishedLectures.map((entry) => entry.id));
const pad = (n: number) => String(n).padStart(2, "0");
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A lecture theatre reduced to flat gold and black shapes, rows of seats sweeping past the frame, in a two-ink risograph print"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <section aria-labelledby="the-shelf">
    <h2 id="the-shelf">The Shelf</h2>
    <p>
      Twelve weeks, twelve cases. Every tag holds a lost object waiting on
      intake --- flip it for the question the shift answers and what the
      Office gains once it's closed.
    </p>
    <ul class="shelf">
      {
        weeks.map((week) => (
          <li>
            <details class="tag">
              <summary>
                <span class="tag-week">Week {pad(week.week)}</span>
                <span class="tag-object">{week.object}</span>
                <span class="tag-stage">{week.stage}</span>
                <span class="tag-flip-hint">
                  Flip for the question
                  <span class="tag-flip-icon" aria-hidden="true">
                    ▸
                  </span>
                </span>
              </summary>
              <div class="tag-back">
                <p class="tag-question">{week.question}</p>
                <p class="tag-gains">
                  <strong>Office gains:</strong> {week.officeGains}
                </p>
                {lectureSlugs.has(week.lectureSlug) && (
                  <p>
                    <a href={withBase(`/lectures/${week.lectureSlug}/`)}>Read the lecture →</a>
                  </p>
                )}
              </div>
            </details>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="follow-a-lost-thing">
    <h2 id="follow-a-lost-thing">Follow a lost thing</h2>
    <p>
      Every case moves through the same twelve stages, in the same order.
      Scroll the shelf to see the whole route a lost thing takes.
    </p>
    <ol class="pipeline" aria-label="The office's twelve stages, in order">
      {
        weeks.map((week) => (
          <li>
            <span class="ticket">
              <span class="ticket-index" aria-hidden="true">
                {pad(week.week)}
              </span>
              {week.stage}
            </span>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="before-your-first-shift">
    <h2 id="before-your-first-shift">Before your first shift</h2>
    <dl class="ledger">
      <div class="ledger-row">
        <dt>The one idea</dt>
        <dd>
          Things are not lost. They are unrecorded. Whether a lost thing
          comes home is a property of the system that catches it — who hands
          it in, how it is written down, where it is kept, how an owner
          proves it is theirs, and what happens when nobody comes.
        </dd>
      </div>
      <div class="ledger-row">
        <dt>The Office</dt>
        <dd>
          In week 1 you deposit one ordinary object with the Office. Each
          week the class builds it one piece further: a hand-in point, an
          intake form, a tracking policy, shelving, a claim protocol, triage
          rules, terms and conditions, an audit, a disposal policy, and a
          match with another tutorial's Office. On Reclaim Day, week 12, you
          get your object back — through the Office's own procedure, not by
          rummaging. The class's return rate is reported, not graded.
        </dd>
      </div>
      <div class="ledger-row">
        <dt>What you deposit</dt>
        <dd>
          <ul>
            <li>Ordinary and replaceable, worth under $20.</li>
            <li>Not ID, not keys that open anything, not medication, not money.</li>
            <li>Not anything you need before week 12.</li>
          </ul>
        </dd>
      </div>
      <div class="ledger-row">
        <dt>Who it is for</dt>
        <dd>
          Second-year, any discipline. No prerequisites: if you have ever
          handed something in to lost property, or waited for something to
          turn up, you already know half of what a shift asks of you.
        </dd>
      </div>
    </dl>
  </section>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
